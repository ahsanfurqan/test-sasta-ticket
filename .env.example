# Copy to .env before `make up`. The Makefile does this for you if .env is missing.

APP_ENV=local
LOG_LEVEL=INFO

# Postgres 16 is the system of record.
POSTGRES_USER=meter
POSTGRES_PASSWORD=meter
POSTGRES_DB=meter
DATABASE_URL=postgresql+asyncpg://meter:meter@postgres:5432/meter

# Redis holds hot-path counters and limit thresholds. Cache and buffer, never truth.
REDIS_URL=redis://redis:6379/0

# SESSION-1 SCAFFOLDING: one hardcoded key standing in for real per-customer API keys.
# Real keys are per customer, stored hashed, resolved from cache. See open question #10.
DEV_API_KEY=dev-key-change-me
